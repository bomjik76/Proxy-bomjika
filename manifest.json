{
  "manifest_version": 3,
  "name": "Прокси bomjika",
  "version": "2.1.0",
  "description": "Приложение для управления и использования прокси серверов браузере",
  "permissions": [
    "proxy",
    "storage",
    "webRequest",
    "webRequestAuthProvider",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["domainLists.js", "domain.txt", "popup.js", "background.js", "proxyServers.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "images/128.png"
    }
  },
  "icons": {
    "128": "images/128.png"
  },
  "commands": {
    "activate-proxy": {
      "suggested_key": {
        "default": "Ctrl+Shift+Up",
        "mac": "MacCtrl+Shift+Up"
      },
      "description": "Активировать прокси"
    },
    "deactivate-proxy": {
      "suggested_key": {
        "default": "Ctrl+Shift+Down",
        "mac": "MacCtrl+Shift+Down"
      },
      "description": "Деактивировать прокси"
    },
    "enable-selective-mode": {
      "suggested_key": {
        "default": "Ctrl+Shift+Right",
        "mac": "MacCtrl+Shift+Right"
      },
      "description": "Включить режим выборочного доступа"
    },
    "disable-selective-mode": {
      "suggested_key": {
        "default": "Ctrl+Shift+Left",
        "mac": "MacCtrl+Shift+Left"
      },
      "description": "Выключить режим выборочного доступа"
    }
  }
} 